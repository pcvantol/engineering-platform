{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-platform.local/schemas/effect-validation-profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "subject",
    "controls",
    "validation_bindings"
  ],
  "properties": {
    "version": {
      "const": "effect-validation@1.0"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "subject_id",
        "subject_digest",
        "source_revision",
        "source_snapshot_digest",
        "effect_contract_digest",
        "criteria_digest",
        "binding_digest",
        "repair_ordinal",
        "candidate_revision"
      ],
      "properties": {
        "subject_kind": {
          "enum": [
            "REPORT_ARTIFACT"
          ]
        },
        "subject_id": {
          "type": "string"
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effect_contract_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "criteria_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repair_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "candidate_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "items": false
      }
    },
    "validation_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "validation_id",
          "category",
          "command"
        ],
        "properties": {
          "validation_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
